diff --git a/test_regress/t/t_force_release_unpacked_whole.v b/test_regress/t/t_force_release_unpacked_whole.v
new file mode 100644
index 000000000..9402972b6
--- /dev/null
+++ b/test_regress/t/t_force_release_unpacked_whole.v
@@ -0,0 +1,172 @@
+// DESCRIPTION: Verilator: Verilog Test module
+//
+// This file ONLY is placed under the Creative Commons Public Domain
+// SPDX-FileCopyrightText: 2026 Graeme Smecher
+// SPDX-License-Identifier: CC0-1.0
+
+// verilog_format: off
+`define stop $stop
+`define checkh(gotv,expv) do if ((gotv) !== (expv)) begin $write("%%Error: %s:%0d:  got='h%x exp='h%x\n", `__FILE__,`__LINE__, (gotv), (expv)); `stop; end while(0)
+// verilog_format: on
+
+// Force and release of a whole unpacked array, as Xilinx's XPM CDC models
+// do to mimic GSR (force ff = '{default:0}; ... release ff;), and of a row
+// or slice of one
+
+module t;
+
+  typedef struct {
+    logic [3:0] a;
+    logic [3:0] b;
+  } ps_t;
+
+  logic [3:0] var_arr[2];  // A variable: keeps the forced value after release
+  wire [3:0] net_arr[2];  // A net: returns to its driver on release
+  logic [3:0] src[2];
+  logic [3:0] arr2d[2][3];  // Two unpacked dimensions
+  logic [3:0] row[2][3];  // Forced by row
+  logic [3:0] slc[4];  // Forced by slice
+  logic [3:0] cpy[2];  // Forced to another array: follows it
+  logic [3:0] elm[2];  // Forced by element, released whole
+  logic [3:0] pca[2];  // Procedural continuous assign, then deassign
+  logic [3:0] rev[1:0];  // Opposite direction to src: pairs left to right
+  logic [3:0] rvp[1:0];  // Forced to a pattern, which is left to right too
+  ps_t sta[2];  // Of structs, forced to a struct variable: follows it
+  ps_t psv;
+  logic [3:0] fca[2] /*verilator forceable*/;  // Also forceable externally
+
+  assign net_arr[0] = src[0];
+  assign net_arr[1] = src[1];
+
+  initial begin
+    var_arr[0] = 4'h1;
+    var_arr[1] = 4'h2;
+    src[0] = 4'h3;
+    src[1] = 4'h4;
+    arr2d = '{'{4'h1, 4'h2, 4'h3}, '{4'h4, 4'h5, 4'h6}};
+    row = '{'{4'h1, 4'h2, 4'h3}, '{4'h4, 4'h5, 4'h6}};
+    slc = '{4'h1, 4'h2, 4'h3, 4'h4};
+    cpy = '{4'h1, 4'h2};
+    elm = '{4'h1, 4'h2};
+    pca = '{4'h1, 4'h2};
+    rev = '{4'h1, 4'h2};
+    rvp = '{4'h1, 4'h2};
+    sta = '{'{4'h1, 4'h2}, '{4'h3, 4'h4}};
+    psv = '{4'h5, 4'h6};
+    fca = '{4'h1, 4'h2};
+    #1;
+    `checkh(net_arr[0], 4'h3);
+    `checkh(net_arr[1], 4'h4);
+
+    force var_arr = '{default: 4'h0};
+    force net_arr = '{4'h5, 4'h6};
+    force arr2d = '{default: 4'hf};
+    force row[1] = '{4'ha, 4'hb, 4'hc};
+    force slc[1:2] = src;
+    force cpy = src;
+    force elm[0] = 4'hc;
+    force elm[1] = 4'hd;
+    // verilator lint_off IEEEMAYDEPRECATE
+    assign pca = src;
+    // verilator lint_on IEEEMAYDEPRECATE
+    force rev = src;
+    force rvp = '{4'ha, 4'hb};
+    force sta = '{default: psv};
+    force fca = '{4'h5, 4'h6};
+    #1;
+    `checkh(arr2d[0][0], 4'hf);
+    `checkh(arr2d[1][2], 4'hf);
+    `checkh(row[0][0], 4'h1);
+    `checkh(row[1][0], 4'ha);
+    `checkh(row[1][2], 4'hc);
+    `checkh(slc[0], 4'h1);
+    `checkh(slc[1], 4'h3);
+    `checkh(slc[2], 4'h4);
+    `checkh(slc[3], 4'h4);
+    `checkh(cpy[0], 4'h3);
+    `checkh(cpy[1], 4'h4);
+    `checkh(elm[0], 4'hc);
+    `checkh(elm[1], 4'hd);
+    `checkh(pca[0], 4'h3);
+    `checkh(pca[1], 4'h4);
+    `checkh(rev[1], 4'h3);
+    `checkh(rev[0], 4'h4);
+    `checkh(rvp[1], 4'ha);
+    `checkh(rvp[0], 4'hb);
+    `checkh(sta[0].a, 4'h5);
+    `checkh(sta[1].b, 4'h6);
+    `checkh(fca[0], 4'h5);
+    `checkh(fca[1], 4'h6);
+    `checkh(var_arr[0], 4'h0);
+    `checkh(var_arr[1], 4'h0);
+    `checkh(net_arr[0], 4'h5);
+    `checkh(net_arr[1], 4'h6);
+
+    var_arr[0] = 4'h7;  // Ignored while forced
+    src[1] = 4'h8;
+    sta[1].b = 4'h9;  // Ignored while forced
+    fca[0] = 4'h7;  // Ignored while forced
+    psv.a = 4'h7;
+    #1;
+    `checkh(var_arr[0], 4'h0);
+    `checkh(net_arr[1], 4'h6);
+    `checkh(cpy[1], 4'h8);  // A force is continuous
+    `checkh(rev[0], 4'h8);
+    `checkh(pca[1], 4'h8);
+    `checkh(sta[1].a, 4'h7);
+    `checkh(sta[1].b, 4'h6);
+    `checkh(fca[0], 4'h5);
+
+    release var_arr;
+    release net_arr;
+    release arr2d;
+    release row[1];
+    release slc[1:2];
+    release cpy;
+    release elm;
+    // verilator lint_off IEEEMAYDEPRECATE
+    deassign pca;
+    // verilator lint_on IEEEMAYDEPRECATE
+    release sta;
+    release fca;
+    #1;
+    `checkh(arr2d[1][2], 4'hf);
+    `checkh(row[1][2], 4'hc);
+    `checkh(slc[2], 4'h8);  // Last forced value: src[1] changed
+    `checkh(cpy[1], 4'h8);
+    `checkh(elm[0], 4'hc);
+    `checkh(pca[1], 4'h8);
+    `checkh(sta[1].a, 4'h7);
+    `checkh(fca[0], 4'h5);  // Keeps the forced value until next written
+    `checkh(fca[1], 4'h6);
+    `checkh(var_arr[0], 4'h0);  // Keeps the forced value until next written
+    `checkh(var_arr[1], 4'h0);
+    `checkh(net_arr[0], 4'h3);
+    `checkh(net_arr[1], 4'h8);
+
+    var_arr[1] = 4'h9;
+    arr2d[1][2] = 4'h9;
+    row[1][2] = 4'h9;
+    slc[2] = 4'h9;
+    cpy[1] = 4'h9;
+    elm[0] = 4'h9;
+    pca[1] = 4'h9;
+    sta[1].b = 4'h9;
+    fca[1] = 4'h9;
+    #1;
+    `checkh(var_arr[1], 4'h9);
+    `checkh(arr2d[1][2], 4'h9);
+    `checkh(row[1][2], 4'h9);
+    `checkh(slc[2], 4'h9);
+    `checkh(cpy[1], 4'h9);
+    `checkh(elm[0], 4'h9);
+    `checkh(pca[1], 4'h9);
+    `checkh(sta[1].b, 4'h9);
+    `checkh(fca[0], 4'h5);
+    `checkh(fca[1], 4'h9);
+
+    $write("*-* All Finished *-*\n");
+    $finish;
+  end
+
+endmodule

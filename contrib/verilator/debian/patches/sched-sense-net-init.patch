         if (!nodep->sensp()) return;  // Ignore sequential items (e.g.: initial, comb, etc.)
 
+        // A change sense on a continuously assigned signal fires at time 0: the signal is z
+        // (a net, IEEE 1800-2023 6.6) or x (a variable) until the continuous assignment is
+        // first evaluated at time 0 (4.9.1), which is a value change (9.4.2).  Not with a
+        // delay on the assignment or the net, which only schedules the update then; and not
+        // for a variable with a declaration initializer, set before any process starts
+        // (6.8).  Decided here, before V3Gate replaces the signal by its driver expression.
+        if (nodep->edgeType() == VEdgeType::ET_CHANGED
+            && nodep->sensp()->exists([](const AstVarRef* refp) {
+                   return refp->varp()->isContinuouslyUndelayed();
+               })) {
+            nodep->fireAtInit(true);
+        }
+
         m_clockedProcess = true;
         if (nodep->edgeType() != VEdgeType::ET_CHANGED) m_allChanged = false;
 

diff --git a/test_regress/t/t_sched_sense_net_init.v b/test_regress/t/t_sched_sense_net_init.v
new file mode 100644
index 000000000..724db2d87
--- /dev/null
+++ b/test_regress/t/t_sched_sense_net_init.v
@@ -0,0 +1,129 @@
+// DESCRIPTION: Verilator: Verilog Test module
+//
+// This file ONLY is placed under the Creative Commons Public Domain
+// SPDX-FileCopyrightText: 2026 Graeme Smecher
+// SPDX-License-Identifier: CC0-1.0
+
+// A change sensitivity on a continuously assigned signal fires once at time 0.
+// IEEE 1800-2023: a net is z until it assumes the value of its drivers (6.6); a continuous
+// assignment process is evaluated at time zero (4.9.1), also the implicit one of a port
+// connection (4.9.6); that is a value change, which an event control observes (9.4.2).
+// A variable with a declaration initializer is set before any procedure starts (6.8), so
+// its initialization is not an event.
+//
+// Compiled with and without --timing (t_sched_sense_net_init_timing.py defines
+// WITH_TIMING): the processes below are scheduled differently in the two flows.
+
+`ifdef WITH_TIMING
+module t;
+  reg clk = 1'b0;
+  always #5 clk = ~clk;
+`else
+module t (
+    input wire clk
+);
+`endif
+
+  reg a = 1'b0;
+  reg b;
+  initial b = 1'b1;
+
+  // Net driven by logic, sensitivity declared after the driver
+  wire w = a & b;
+  reg fired_w = 1'b0;
+  always @(w) fired_w <= 1'b1;
+
+  // Net driven by logic, sensitivity declared before the driver
+  wire w2;
+  reg fired_w2 = 1'b0;
+  always @(w2) fired_w2 <= 1'b1;
+  assign w2 = a | b;
+
+  // Net driven by a submodule output (an implicit continuous assignment, 4.9.6)
+  wire w3;
+  reg fired_w3 = 1'b0;
+  always @(w3) fired_w3 <= 1'b1;
+  sub u_sub (.i(a), .o(w3));
+
+  // Net driven by a constant (as before)
+  wire wc = 1'b1;
+  reg fired_wc = 1'b0;
+  always @(wc) fired_wc <= 1'b1;
+
+  // Variable with a continuous assignment: x until its first evaluation
+  logic v2;
+  assign v2 = a ^ b;
+  reg fired_v2 = 1'b0;
+  always @(v2) fired_v2 <= 1'b1;
+
+  // Variable with a declaration initializer: no event (6.8)
+  reg v = 1'b0;
+  reg fired_v = 1'b0;
+  always @(v) fired_v <= 1'b1;
+
+  // Variable without an initializer, never written: no event
+  reg u;
+  reg fired_u = 1'b0;
+  always @(u) fired_u <= 1'b1;
+
+  // The pattern of xpm_fifo_axis (gaxis_pkt_fifo_ic): a pad set by a sensitivity on a net
+  // that is 0 after its first evaluation; without the time-0 event it would stay 0
+  wire rd_eop = a & b;  // 0 at time 0
+  reg pad0 = 1'b0;
+  reg pad1 = 1'b0;
+  always @(rd_eop) begin
+    if (rd_eop == 1'b0) begin
+      pad0 <= 1'b1;
+      pad1 <= 1'b1;
+    end else begin
+      pad0 <= 1'b0;
+      pad1 <= 1'b0;
+    end
+  end
+
+  // A suspendable process waiting on the same net (--timing only)
+  reg fired_t = 1'b0;
+`ifdef WITH_TIMING
+  task automatic wait_w;
+    @(w);
+    fired_t = 1'b1;
+  endtask
+  initial wait_w();
+`else
+  initial fired_t = 1'b1;
+`endif
+
+  int cyc = 0;
+  always @(posedge clk) begin
+    cyc <= cyc + 1;
+    if (cyc == 2) begin
+      if (fired_w !== 1'b1) $stop;
+      if (fired_w2 !== 1'b1) $stop;
+      if (fired_w3 !== 1'b1) $stop;
+      if (fired_wc !== 1'b1) $stop;
+      if (fired_v2 !== 1'b1) $stop;
+      if (fired_v !== 1'b0) $stop;
+      if (fired_u !== 1'b0) $stop;
+      if (pad0 !== 1'b1 || pad1 !== 1'b1) $stop;
+      if (fired_t !== 1'b1) $stop;
+      // Later changes still fire
+      fired_w <= 1'b0;
+      pad0 <= 1'b0;
+    end
+    if (cyc == 3) a <= 1'b1;  // w: 0 -> 1, rd_eop: 0 -> 1
+    if (cyc == 5) begin
+      if (fired_w !== 1'b1) $stop;
+      if (pad0 !== 1'b0) $stop;
+      $write("*-* All Finished *-*\n");
+      $finish;
+    end
+  end
+
+endmodule
+
+module sub (
+    input wire i,
+    output wire o
+);
+  assign o = ~i;
+endmodule
